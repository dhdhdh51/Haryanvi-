<?xml version="1.0" encoding="utf-8"?>
<!--
    Input method declaration for the Haryanvi keyboard.

    Two subtypes so the user can switch script with the system's own
    language switcher as well as from the keyboard itself.
-->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.haryanvi.translator.keyboard.KeyboardSettingsActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <subtype
        android:label="@string/subtype_hindi"
        android:imeSubtypeLocale="hi_IN"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="false"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=devanagari" />

    <subtype
        android:label="@string/subtype_english"
        android:imeSubtypeLocale="en_IN"
        android:imeSubtypeMode="keyboard"
        android:isAsciiCapable="true"
        android:imeSubtypeExtraValue="KeyboardLayoutSet=qwerty" />

</input-method>
