<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer policy for Android 12+.

    Same include-only policy as backup_rules.xml: naming one included path
    means everything else is excluded, so the auth token and the translation
    history database never leave the device through a backup or a transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/haryanvi_settings.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="datastore/haryanvi_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
