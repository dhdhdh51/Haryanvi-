<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Compose owns the in-app look; this theme only sets what the system
        draws around it (window background, status/navigation bars) so there
        is no white flash before the first frame.
    -->
    <style name="Theme.HaryanviAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/hy_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/hy_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>
    </style>

    <!-- Launch theme: the branded splash, handed over to Compose on first frame. -->
    <style name="Theme.HaryanviAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/hy_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.HaryanviAI</item>
    </style>

    <!--
        Keyboard theme. The IME inflates classic Views, so its colours come
        from here rather than from Compose.
    -->
    <style name="Theme.HaryanviKeyboard" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/hy_keyboard_bg</item>
    </style>

    <!-- Key label styles reused across every key in the layouts. -->
    <style name="KeyLabel">
        <item name="android:textColor">@color/hy_text</item>
        <item name="android:textSize">19sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="KeyLabel.Special" parent="KeyLabel">
        <item name="android:textColor">@color/hy_text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

</resources>
