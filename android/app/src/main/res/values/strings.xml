    <!-- ============================ Onboarding ============================ -->
    <string name="onboarding_skip">Skip</string>
    <string name="onboarding_next">Next</string>
    <string name="onboarding_start">Get started</string>

    <string name="onboarding_1_title">Write in Hindi or English</string>
    <string name="onboarding_1_body">Type your message the way you normally would. Haryanvi AI rewrites it in natural, regional Haryanvi before you send it.</string>

    <string name="onboarding_2_title">Choose your region and tone</string>
    <string name="onboarding_2_body">Rohtak, Hisar, Sonipat, Jind or general Haryanvi — and pick whether it should sound friendly, respectful, village or modern.</string>

    <string name="onboarding_3_title">Send from any chat app</string>
    <string name="onboarding_3_body">Use the Haryanvi keyboard to translate right inside WhatsApp, Instagram or Telegram, or share text into the app. You always press translate yourself.</string>

    <string name="onboarding_4_title">Your messages stay yours</string>
    <string name="onboarding_4_body">We never read your chats, never log your keystrokes and never send anything without you asking. Only the text you press translate on is sent.</string>

