    <!-- ============================ Privacy ============================ -->
    <string name="privacy_title">Privacy</string>
    <string name="privacy_save_history">Save translation history</string>
    <string name="privacy_save_history_help">When off, nothing is stored and your existing history is deleted immediately.</string>
    <string name="privacy_cloud_sync">Sync history across devices</string>
    <string name="privacy_cloud_sync_help">Keeps your saved translations available when you sign in elsewhere.</string>
    <string name="privacy_what_we_do">What this app does and does not do</string>
    <string name="privacy_policy_title">Privacy policy</string>
    <string name="privacy_promises">
        • Only the text you press Translate on is sent to the server.\n
        • Your chats are never read and never monitored.\n
        • Keystrokes are never collected or stored.\n
        • The keyboard is disabled in password and other private fields.\n
        • The clipboard is only read when you tap paste.\n
        • Nothing is ever sent on your behalf.\n
        • Your translation data is not sold.
    </string>

